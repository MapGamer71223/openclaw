# ============================================================
# Core mode
# ============================================================
DEMO_MODE=true

# ============================================================
# Database / uploads (unchanged)
# ============================================================
# DATABASE_URL=sqlite:///./data/forensics.db
# MAX_UPLOAD_SIZE_MB=100

# ============================================================
# Provenance database -- our own growing image index (Postgres+pgvector).
# Separate from DATABASE_URL above. Bring up `docker compose up provdb`
# (or your own Postgres with the vector extension) and point this at it.
# Leave empty to run without this layer (existing pipeline is unaffected).
# ============================================================
# PROVENANCE_DATABASE_URL=postgresql+psycopg2://provenance:provenance@localhost:5433/provenance

# ============================================================
# AI-image detector (real mode). Default is a real, local, offline
# Vision Transformer -- no API key, no cost. Set to false only to force
# an honest NOT_AVAILABLE (e.g. torch/transformers not installed here).
# ============================================================
# AI_DETECTOR_CONFIGURED=true
# AI_DETECTOR_MODEL_ID=Organika/sdxl-detector

# ============================================================
# OSINT / real-mode providers (unused in DEMO_MODE).
#
# Provider priority (first configured wins), see source_search.get_source_provider():
#   1. GOOGLE_VISION_API_KEY -- RECOMMENDED. Official Google Cloud Vision
#                          Web Detection API (same tech as Google Images'
#                          "Find image source"), called via a real,
#                          versioned REST API -- not scraped HTML, so it
#                          doesn't silently break the way options 2-3
#                          below can. First 1000 calls/month free, then
#                          $3.50/1000. Get a key at console.cloud.google.com
#                          (enable "Cloud Vision API" -> Credentials ->
#                          Create API key).
#   2. PICIMAGESEARCH_ENABLED -- free, unofficial, scrapes Google/Yandex/
#                          TinEye search-by-image pages in one process.
#                          One engine getting blocked doesn't zero out the
#                          whole result set, but any/all of them can go
#                          silently empty or start erroring without notice
#                          whenever the target site changes its markup or
#                          starts treating the traffic as a bot.
#                          `pip install PicImageSearch`.
#   3. MRISA_URL       -- legacy, self-hosted (github.com/vivithemage/mrisa),
#                          only used when PICIMAGESEARCH_ENABLED is false.
#                          Scrapes Google's search-by-image HTML for
#                          specific CSS classes; breaks whenever Google
#                          changes its markup (has already happened).
#   4. BRAVE_API_KEY   -- real web search via Brave's API, but text-query
#                          based, NOT true reverse-image search.
#   5. (fallback)      -- DDGSourceProvider: free, keyless DuckDuckGo
#                          text+image search (via the `ddgs` package).
#                          Also NOT true reverse-image search.
#
# Independent of which provider above runs, any candidate URL missing a
# real publication date gets a best-effort "earliest seen" date backfilled
# from the free, keyless Wayback Machine CDX API -- see WAYBACK_ENRICH_DATES.
# ============================================================
# GOOGLE_VISION_API_KEY=
# WAYBACK_ENRICH_DATES=true
# WAYBACK_ENRICH_MAX_CANDIDATES=15

# PICIMAGESEARCH_ENABLED=true
# PICIMAGESEARCH_ENGINES=google,yandex,tineye
# MRISA_URL=http://127.0.0.1:5000
# BRAVE_API_KEY=
# XAI_API_KEY=
# REVERSE_IMAGE_SEARCH_API_KEY=

# ============================================================
# OpenClaw integration
# ============================================================
OPENCLAW_ENABLED=false

# Path to the OpenClaw workspace. May be relative -- it is resolved
# against the repository root (not the process's working directory).
OPENCLAW_WORKSPACE=./openclaw

# Which configured OpenClaw agent drives investigations. Do not use "main".
OPENCLAW_AGENT=crestodian

# Base URL the backend tells the dispatched agent to call back into.
OPENCLAW_BACKEND_BASE_URL=http://127.0.0.1:8000

# Shared-secret bearer token required on every /api/investigations/{id}/agent/*
# call. Leave empty only for trusted localhost development.
OPENCLAW_API_TOKEN=

# Template for the CLI command used to dispatch/notify the agent.
# VERIFY THIS against your installed OpenClaw CLI (`openclaw --help`,
# `openclaw agent --help`) before relying on it -- it has not been executed
# against a live OpenClaw install in this environment.
# Placeholders: {agent} {workspace} {investigation_id} {base_url} {message}
OPENCLAW_CLI_COMMAND_TEMPLATE=openclaw agent --agent {agent} --workspace "{workspace}" --message "{message}"

# Seconds to wait for the dispatch subprocess to *launch* (not finish).
OPENCLAW_DISPATCH_LAUNCH_TIMEOUT_SECONDS=5

# Explicit opt-in: if dispatch to OpenClaw fails outright, fall back to the
# native orchestrator instead of marking the investigation FAILED. Default
# false -- failures are surfaced, never silently masked.
OPENCLAW_ALLOW_NATIVE_FALLBACK=false

# If a non-terminal investigation gets no new events for this long, it's
# assumed the agent disconnected/crashed and is auto-marked FAILED.
OPENCLAW_STALL_TIMEOUT_SECONDS=600

# ============================================================
# CORS
# ============================================================
# FRONTEND_ORIGIN=http://localhost:5173
