# Copy this file to `.env` in this same folder (artifacts/verisight-ai/.env)
# and fill in the URL for YOUR backend. Expo automatically inlines any
# EXPO_PUBLIC_* variable into the app at build/start time.
#
# Pick the line that matches how you're running the app. Only one should be
# active (uncommented) at a time.

# iOS Simulator (shares your Mac's network -- localhost works):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Android Emulator (10.0.2.2 is the emulator's alias for your host machine):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical phone via Expo Go / dev build (use your computer's LAN IP --
# find it with `ipconfig getifaddr en0` on Mac, or `ipconfig` on Windows.
# Your phone and computer must be on the same Wi-Fi network):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000

# Production / deployed backend:
# EXPO_PUBLIC_API_BASE_URL=https://api.jansatark.example.com

# If this is left unset, services/api.ts makes a best-effort guess using the
# Expo dev server's own host, which works for most local physical-device
# testing but should not be relied on for anything beyond that.
